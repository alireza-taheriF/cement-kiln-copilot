# ---------------------------------------------------------------------------
# cement-kiln-copilot environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Application ---
APP_ENV=development            # development | staging | production
LOG_LEVEL=INFO

# --- Database (PostgreSQL) ---
# Full SQLAlchemy URL takes precedence if set, otherwise components are used.
DATABASE_URL=postgresql+psycopg2://copilot:copilot@localhost:5432/cement_copilot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cement_copilot
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- ML / artifacts ---
MODEL_ARTIFACT_DIR=artifacts
MODEL_CONFIG_PATH=config/model_config.yaml
# Path to the trained model artifact loaded by the prediction/recommendation API.
MODEL_PATH=artifacts/models/kiln_zone1_temp_model.joblib

# --- Dashboard ---
API_BASE_URL=http://localhost:8000
